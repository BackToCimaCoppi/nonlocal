    },
    "Nonlocal can't undo file changes yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal kann Dateiänderungen noch nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal can't undo file changes yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal aún no puede deshacer cambios de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal ne peut pas encore annuler les modifications de fichiers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal에서는 아직 파일 변경을 되돌릴 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal пока не может отменять изменения файлов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal 暂不支持撤销文件更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal 暫不支援復原檔案變更。"
          }
        }
      }
    },
    "Nonlocal keeps a local session list so sessions still show up after app restart. If the agent restarts and forgets sessions, older sessions may stop working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal führt eine lokale Sitzungsliste, damit Sitzungen nach einem App-Neustart weiterhin sichtbar bleiben. Wenn der Agent neu startet und Sitzungen vergisst, funktionieren ältere Sitzungen möglicherweise nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal keeps a local session list so sessions still show up after app restart. If the agent restarts and forgets sessions, older sessions may stop working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal guarda una lista local de sesiones para que sigan apareciendo tras reiniciar la app. Si el agente se reinicia y olvida las sesiones, las más antiguas podrían dejar de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal conserve une liste locale des sessions afin qu'elles restent visibles après le redémarrage de l'app. Si l'agent redémarre et oublie les sessions, les plus anciennes risquent de ne plus fonctionner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal은 앱을 재시작한 후에도 세션이 표시되도록 로컬 세션 목록을 유지합니다. 에이전트가 재시작되어 세션을 잊으면 이전 세션이 작동하지 않을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal хранит локальный список сессий, чтобы они отображались после перезапуска приложения. Если агент перезапустится и забудет сессии, старые сессии могут перестать работать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal 会在本地保存会话列表，以便重启应用后仍可显示会话。如果代理重启并丢失会话记录，旧会话可能无法继续使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal 會在本機保存工作階段清單，以便重新啟動應用程式後仍可顯示。若代理程式重新啟動並遺失工作階段記錄，舊工作階段可能無法繼續使用。"
          }
        }
      }
    },
    "Nonlocal stores chat history locally so you can browse sessions and past conversations, but the agent can’t restore context for new messages. If the agent/server restarts, old session IDs may stop working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal speichert den Chatverlauf lokal, sodass Sie Sitzungen und frühere Gespräche durchsuchen können, aber der Agent kann den Kontext für neue Nachrichten nicht wiederherstellen. Nach einem Neustart von Agent/Server funktionieren alte Sitzungs-IDs möglicherweise nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal stores chat history locally so you can browse sessions and past conversations, but the agent can’t restore context for new messages. If the agent/server restarts, old session IDs may stop working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal guarda el historial localmente para que puedas explorar sesiones y conversaciones pasadas, pero el agente no puede restaurar el contexto en nuevos mensajes. Si el agente o el servidor se reinician, los ID de sesión antiguos pueden dejar de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal stocke l'historique localement pour consulter les sessions et conversations passées, mais l'agent ne peut pas restaurer le contexte des nouveaux messages. Si l'agent ou le serveur redémarre, les anciens ID de session peuvent cesser de fonctionner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal은 세션과 이전 대화를 볼 수 있도록 채팅 기록을 로컬에 저장하지만, 에이전트가 새 메시지의 컨텍스트를 복원할 수는 없습니다. 에이전트나 서버가 재시작되면 이전 세션 ID가 작동하지 않을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal хранит историю чата локально, чтобы вы могли просматривать сессии и прошлые беседы, но агент не может восстановить контекст для новых сообщений. При перезапуске агента или сервера старые ID сессий могут перестать работать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal 在本地保存聊天记录以便浏览会话和历史对话，但代理无法为新消息恢复上下文。如果代理或服务器重启，旧会话 ID 可能失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonlocal 在本機儲存聊天記錄以便瀏覽工作階段與歷史對話，但代理程式無法為新訊息復原上下文。若代理程式或伺服器重新啟動，舊工作階段 ID 可能失效。"
          }
        }
      }
    },
