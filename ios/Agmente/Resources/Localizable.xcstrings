    "Unbinding a directory only updates local project grouping and never deletes sessions or host files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufheben einer Verzeichnisverknüpfung aktualisiert nur die lokale Projektgruppierung und löscht niemals Sitzungen oder Hostdateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbinding a directory only updates local project grouping and never deletes sessions or host files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincular un directorio solo actualiza la agrupación local de proyectos y nunca elimina sesiones ni archivos del host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier un répertoire met uniquement à jour le regroupement local des projets et ne supprime jamais de sessions ni de fichiers hôtes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디렉터리 연결을 해제해도 로컬 프로젝트 그룹화만 업데이트되며 세션이나 호스트 파일은 삭제되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвязка каталога обновляет только локальную группировку проектов и никогда не удаляет сессии или файлы на хосте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解绑目录仅会更新本地项目分组，绝不会删除会话或主机文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除繫結目錄僅會更新本機專案分組，絕不會刪除工作階段或主機檔案。"
          }
        }
      }
    },
