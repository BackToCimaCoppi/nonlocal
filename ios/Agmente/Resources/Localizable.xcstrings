    "Applies only to new sessions on this server; manually switching the model in an existing session keeps your chosen model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für neue Sitzungen auf diesem Server; ein manueller Modellwechsel in einer bestehenden Sitzung behält das gewählte Modell bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to new sessions on this server; manually switching the model in an existing session keeps your chosen model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica a las sesiones nuevas en este servidor; si cambias manualmente el modelo en una sesión existente, se mantendrá tu elección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique uniquement aux nouvelles sessions sur ce serveur ; le changement manuel de modèle dans une session existante conserve votre choix."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버의 새 세션에만 적용됩니다. 기존 세션에서 모델을 수동으로 전환하면 선택한 모델이 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется только к новым сессиям на этом сервере; при ручном переключении модели в текущей сессии сохраняется выбранная модель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于此服务器上的新会话；在已有会话中手动切换模型后将保留您的选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於此伺服器上的新工作階段；在現有工作階段中手動切換模型後將保留您的選擇。"
          }
        }
      }
    },
