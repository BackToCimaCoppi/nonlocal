            "value": "No se admite la vista previa en línea para imágenes mayores de 10 MB%@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu en ligne n'est pas pris en charge pour les images de plus de 10 Mo%@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
