            "state": "translated",
            "value": "Se requiere un directorio de trabajo para que el agente opere de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un répertoire de travail est requis pour que l'agent fonctionne en toute sécurité."
          }
