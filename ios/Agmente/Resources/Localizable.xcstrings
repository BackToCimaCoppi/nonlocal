    "Most ACP agents do not expose session/list; sessions are cached locally while this app is running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten ACP-Agenten stellen session/list nicht bereit; Sitzungen werden lokal zwischengespeichert, solange die App läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most ACP agents do not expose session/list; sessions are cached locally while this app is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los agentes ACP no exponen session/list; las sesiones se guardan en caché local mientras la app está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des agents ACP n'exposent pas session/list ; les sessions sont mises en cache localement pendant l'exécution de l'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 ACP 에이전트는 session/list를 제공하지 않으며, 앱 실행 중 세션이 로컬에 캐시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство агентов ACP не предоставляют session/list; сессии кэшируются локально во время работы приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数 ACP 代理不提供 session/list；应用运行期间会话会缓存在本地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大多數 ACP 代理程式不提供 session/list；應用程式執行期間工作階段會快取於本機。"
          }
        }
      }
    },
