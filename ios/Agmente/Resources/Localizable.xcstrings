    "Requests and responses will appear here while you interact with the agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen und Antworten erscheinen hier, während Sie mit dem Agenten interagieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests and responses will appear here while you interact with the agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes y respuestas aparecerán aquí mientras interactúas con el agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes et réponses apparaîtront ici pendant vos échanges avec l'agent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트와 상호작용하는 동안 요청과 응답이 여기에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы и ответы будут появляться здесь во время взаимодействия с агентом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与代理交互时的请求与响应将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與代理程式互動時的請求與回應會顯示在這裡。"
          }
        }
      }
    },
