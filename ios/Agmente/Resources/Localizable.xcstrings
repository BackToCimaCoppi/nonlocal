    "Are you sure you want to delete \"%@\"? This will remove all cached sessions for this server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie „%@“ wirklich löschen? Alle zwischengespeicherten Sitzungen dieses Servers werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete \"%@\"? This will remove all cached sessions for this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar «%@»? Se eliminarán todas las sesiones en caché de este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer « %@ » ? Toutes les sessions en cache de ce serveur seront supprimées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"을(를) 삭제하시겠습니까? 이 서버의 캐시된 모든 세션이 제거됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить «%@»? Все кэшированные сессии для этого сервера будут удалены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除“%@”吗？这将移除此服务器的所有缓存会话。"
