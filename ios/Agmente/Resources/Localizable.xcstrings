    "%@ is not a compatible Nonlocal Bridge server. Please check the server address and bridge version.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kein kompatibler Nonlocal-Bridge-Server. Bitte prüfe die Serveradresse und die Bridge-Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a compatible Nonlocal Bridge server. Please check the server address and bridge version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es un servidor Nonlocal Bridge compatible. Comprueba la dirección del servidor y la versión del puente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas un serveur Nonlocal Bridge compatible. Vérifiez l’adresse du serveur et la version de la passerelle."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 호환되는 Nonlocal Bridge 서버가 아닙니다. 서버 주소와 브리지 버전을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не является совместимым сервером Nonlocal Bridge. Проверьте адрес сервера и версию моста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是兼容的 Nonlocal 桥接服务器，请检查服务器地址与桥接版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是相容的 Nonlocal 橋接伺服器，請檢查伺服器位址與橋接版本。"
          }
        }
      }
    },
