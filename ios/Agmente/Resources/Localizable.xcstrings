    "Using root (/) as working directory is dangerous and may crash the agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stammverzeichnis (/) als Arbeitsverzeichnis zu verwenden ist gefährlich und kann den Agenten zum Absturz bringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using root (/) as working directory is dangerous and may crash the agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar la raíz (/) como directorio de trabajo es peligroso y puede hacer fallar al agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la racine (/) comme répertoire de travail est dangereux et peut faire planter l'agent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트(/)를 작업 디렉터리로 사용하는 것은 위험하며 에이전트가 충돌할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование корня (/) как рабочего каталога опасно и может привести к сбою агента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将根目录 (/) 设为工作目录存在风险，可能导致代理崩溃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將根目錄 (/) 設為工作目錄具有風險，可能導致代理程式當機。"
          }
        }
      }
    },
